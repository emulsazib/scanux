;
; scanu_flt.inf: Scanu minifilter (test-signed dev build)
;
; ALTITUDE: 328010 is a placeholder inside the FSFilter Anti-Virus range
; (320000-329999). A production altitude must be allocated by Microsoft
; (https://learn.microsoft.com/windows-hardware/drivers/ifs/allocated-altitudes).
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "AntiVirus"
ClassGuid   = {b1d1a169-c54f-4379-81db-bee7d88d7454}
Provider    = %ManufacturerName%
DriverVer   = 10/30/2026,0.1.0.0
CatalogFile = scanu_flt.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir     = 13
MiniFilter.CopyFiles = 13

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = MiniFilter.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,MiniFilter.Service

[MiniFilter.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %13%\%DriverName%.sys
Dependencies   = "FltMgr"
ServiceType    = 2          ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 1          ; SERVICE_SYSTEM_START (ELAM-class boot start needs MVI)
ErrorControl   = 1
LoadOrderGroup = "FSFilter Anti-Virus"
AddReg         = MiniFilter.AddRegistry

[MiniFilter.AddRegistry]
HKR,,"DebugFlags",0x00010001,0x0
HKR,,"SupportedFeatures",0x00010001,0x3
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[MiniFilter.CopyFiles]
%DriverName%.sys

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
scanu_flt.sys = 1,,

[Strings]
ManufacturerName   = "Scanu"
ServiceDescription = "Scanu endpoint protection minifilter"
ServiceName        = "scanu_flt"
DriverName         = "scanu_flt"
DiskId1            = "Scanu Installation Disk"
DefaultInstance    = "Scanu Instance"
Instance1.Name     = "Scanu Instance"
Instance1.Altitude = "328010"
Instance1.Flags    = 0x0
