{
  "type": "function",
  "name": "propose_playbook",
  "description": "Propose a containment playbook for human approval. Nothing is executed by calling this. Every target must be an entity ID from the incident graph.",
  "strict": true,
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": ["incident_id", "recommended_choice", "steps", "explanation"],
    "properties": {
      "incident_id": {"type": "string", "pattern": "^inc_[0-9a-f]{32}$"},
      "recommended_choice": {
        "type": "string",
        "enum": ["terminate_and_quarantine", "isolate_network_only", "allow_and_whitelist"]
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "target_entity_id"],
          "properties": {
            "tool": {"type": "string", "enum": ["suspend", "terminate", "net_block", "quarantine", "allowlist"]},
            "target_entity_id": {"type": "string", "pattern": "^(proc|file)_[0-9a-f]{32}$"}
          }
        }
      },
      "explanation": {"type": "string"}
    }
  }
}
