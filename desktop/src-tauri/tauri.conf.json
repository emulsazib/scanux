{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scanu",
  "version": "0.1.0",
  "identifier": "com.scanu.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scanu",
        "width": 460,
        "height": 720,
        "minWidth": 360,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:8000 http://localhost:8000 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Scanu",
    "copyright": "\u00a9 2026 Scanu",
    "category": "Utility",
    "shortDescription": "Scanu endpoint protection",
    "longDescription": "Scanu detects threats on this PC, freezes them in microseconds, scans on demand, and lets you decide what happens next.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/scanu-sensor"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "mainBinaryName": "Scanu"
}