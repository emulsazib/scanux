# Scanu developer entry points.
CARGO ?= $(shell command -v cargo 2>/dev/null || echo /opt/homebrew/opt/rustup/bin/cargo)
export PATH := $(dir $(CARGO)):$(PATH)
PKI := deploy/pki/out
TENANT := 11111111-1111-4111-8111-111111111111
DEVICE ?= dev-sim-1

.PHONY: help pki device proto up down test test-rust test-py check-windows gateway writers api agents web sim-cred sim-ransom sim-offline e2e

help:
	@grep -E '^[a-z-]+:' Makefile | cut -d: -f1 | tr '\n' ' '; echo

pki:                     ## dev CA, gateway cert, command-signing key, one device cert
	$(CARGO) run -q -p devpki -- --out $(PKI) init
	$(MAKE) device

device:
	$(CARGO) run -q -p devpki -- --out $(PKI) device --tenant $(TENANT) --device $(DEVICE)

proto:                   ## regenerate Python protobuf bindings (Rust is generated by build.rs)
	protoc -I schemas/proto --python_out=api/scanu_api/gen --pyi_out=api/scanu_api/gen schemas/proto/scanu/v1/*.proto

up:
	docker compose -f deploy/docker-compose.dev.yml up -d --wait

down:
	docker compose -f deploy/docker-compose.dev.yml down

test: test-rust test-py

test-rust:
	$(CARGO) test --workspace

test-py:
	cd api && uv run pytest -q
	cd agents && uv run pytest -q

check-windows:           ## type-check the Windows-only crates from macOS/Linux
	$(CARGO) check -p sensor-win --target x86_64-pc-windows-msvc   # sensor-svc needs ring (C): check it in the Windows VM

gateway:
	$(CARGO) run -p ingest-gateway -- --pki $(PKI)

writers:
	$(CARGO) run -p ingest-writers

api:
	cd api && SCANU_PKI=../$(PKI) uv run uvicorn scanu_api.main:app --port 8000

agents:
	cd agents && uv run python -m scanu_agents.worker

web:
	cd web && pnpm dev

sim-cred:
	$(CARGO) run -q -p sensor-sim -- --device $(DEVICE) scenario office-cred-theft --linger 600

sim-ransom:
	$(CARGO) run -q -p sensor-sim -- --device $(DEVICE) scenario ransomware --linger 600

sim-offline:
	$(CARGO) run -q -p sensor-sim -- --offline --data .data/sim-offline scenario all --linger 0

e2e:                     ## full loop against running services (see tests/e2e/README.md)
	cd api && uv run python ../tests/e2e/run_e2e.py
